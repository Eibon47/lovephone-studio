{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "your-cloudbase-environment-id",
  "hostingPath": "lovephone",
  "functionRoot": "cloudbase/functions",
  "functions": [
    {
      "name": "ai-gateway",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 256,
      "envVariables": {
        "LOVEPHONE_ALLOWED_ORIGINS": "https://your-site.example"
      },
      "description": "LovePhone AI gateway"
    },
    {
      "name": "wangyiyun66-gateway",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 30,
      "memorySize": 512,
      "installDependency": true,
      "envVariables": {
        "LOVEPHONE_ALLOWED_ORIGINS": "https://your-site.example"
      },
      "description": "LovePhone music gateway"
    }
  ]
}
